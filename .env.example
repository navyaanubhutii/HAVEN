# Haven Environment Configuration Template
# Copy this file to .env and fill in your keys. DO NOT commit .env to version control!

# Supabase Database & Auth Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# FastAPI Backend URL
VITE_API_URL=http://localhost:8000

# Server-Side AI API Keys (Used by Python FastAPI server)
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
